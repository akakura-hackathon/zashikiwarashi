# Local dev
ENVIRONMENT=local
PORT=8080
CORS_ALLOW_ORIGINS=http://localhost:3000

# GCP
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Firestore (ローカル開発では Local Emulator Suite を使用 — README参照)
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_EMULATOR_HOST=localhost:8081

# Secret Manager のリソースパス（値そのものではなく参照パスを書く）
# 例: projects/${GOOGLE_CLOUD_PROJECT}/secrets/some-api-key/versions/latest
SOME_API_KEY_SECRET_RESOURCE=
