        </mxCell>
        <mxCell id="C-022" value="&lt;b&gt;Zashikiwarashi Tools&lt;/b&gt;&lt;br&gt;MCP Server（Cloud Run）&lt;br&gt;住民データ読取・空間グラフ・打診・記録＋[G5]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E8EAF6;strokeColor=#3949AB;" vertex="1" parent="1">
          <mxGeometry x="1440" y="725" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="C-030" value="&lt;b&gt;Cloud Firestore&lt;/b&gt;&lt;br&gt;Issue / Task / TaskEvent /&lt;br&gt;AuditEvent（ER 図準拠）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#F3E5F5;strokeColor=#8E24AA;" vertex="1" parent="1">
