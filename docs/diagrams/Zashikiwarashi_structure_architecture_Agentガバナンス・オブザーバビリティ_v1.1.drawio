        <mxCell id="C-051" value="外部データ連携（拡張 E1〜E4）&lt;br&gt;Calendar / スマートメーター /&lt;br&gt;インターホン　※MVP はダミー" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#F5F5F5;strokeColor=#9E9E9E;" vertex="1" parent="1">
