          <mxGeometry x="610" y="1040" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="C-043" value="&lt;b&gt;[O3] BigQuery（図のみ）&lt;/b&gt;&lt;br&gt;Agent Analytics（イベントのみ）&lt;br&gt;協議ラウンド・Tool 使用・結果" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#757575;align=center;verticalAlign=middle;fillColor=#F5F5F5;strokeColor=#9E9E9E;" vertex="1" parent="1">
          <mxGeometry x="870" y="1040" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="C-044" value="&lt;b&gt;[O4] Cloud Monitoring（余力）&lt;/b&gt;&lt;br&gt;SLO・アラート・ダッシュボード&lt;br&gt;信頼性 / コスト / 安全 / セキュリティ" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E0F7FA;strokeColor=#00838F;" vertex="1" parent="1">
          <mxGeometry x="1130" y="1040" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="C-042" value="&lt;b&gt;[G7] 監査ログバケット&lt;/b&gt;&lt;br&gt;保持ロック（ハッカソン中は未ロック）&lt;br&gt;Gateway 判定・承認・開示の記録" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E0F7FA;strokeColor=#00838F;" vertex="1" parent="1">
          <mxGeometry x="610" y="1140" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="C-045" value="&lt;b&gt;[O5] Online Monitors（図のみ）&lt;/b&gt;&lt;br&gt;Agent Platform のオンライン評価&lt;br&gt;計画品質・ハルシネーション" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#757575;align=center;verticalAlign=middle;fillColor=#F5F5F5;strokeColor=#9E9E9E;" vertex="1" parent="1">
          <mxGeometry x="1130" y="1140" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="C-046" value="&lt;b&gt;[G8] Gen AI Evaluation（余力）&lt;/b&gt;&lt;br&gt;4 シナリオの評価データセット&lt;br&gt;デプロイ前の品質・安全ゲート" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E0F7FA;strokeColor=#00838F;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1140" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="C-060" value="GitHub Actions（WIF）&lt;br&gt;Terraform / agents-cli deploy&lt;br&gt;評価ゲート通過後に反映" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#FFF8E1;strokeColor=#FFB300;" vertex="1" parent="1">
          <mxGeometry x="1740" y="1140" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="KEY" value="&lt;b&gt;提案の要点&lt;/b&gt;&lt;br&gt;&lt;br&gt;① Agent の入出力はすべて &lt;b&gt;Agent Gateway&lt;/b&gt; を経由させる（Ingress / Egress）&lt;br&gt;&lt;br&gt;② &lt;b&gt;Model Armor&lt;/b&gt; で入力（プロンプトインジェクション）と応答（部屋番号・氏名）を検査する&lt;br&gt;&lt;br&gt;③ 権限はコードで強制する：&lt;b&gt;IAP エージェントポリシー&lt;/b&gt;（誰が何を呼べるか）＋ &lt;b&gt;Policy Engine&lt;/b&gt;（承認前の Commit・開示を遮断）&lt;br&gt;&lt;br&gt;④ &lt;b&gt;Agent Identity / Agent Registry&lt;/b&gt; で呼び出し元と宛先を台帳管理する&lt;br&gt;&lt;br&gt;⑤ OTel トレースを plan_id で Agent 横断に追う。プロンプト本文はログに残さない&lt;br&gt;&lt;br&gt;⑥ 評価（デプロイ前＋Online Monitors）とアラートで、品質と安全を継続的に監視する" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;spacingLeft=8;spacingTop=6;strokeColor=#D0D0D0;fillColor=#FAFAFA;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="215" width="250" height="560" as="geometry" />
        </mxCell>
        <mxCell id="TELEMETRY" value="テレメトリの送信元：Agent Gateway / Agent Runtime / Cloud Run の全サービス（OTel SDK・ADK 組込、Gateway ログ）。矢印は省略。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#006064;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1040" width="270" height="64" as="geometry" />
        </mxCell>
        <mxCell id="LG-title" value="凡例" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#1A2538;" vertex="1" parent="1">
          <mxGeometry x="40" y="1275" width="40" height="28" as="geometry" />
        </mxCell>
        <mxCell id="LG-1" value="Client 層" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF3E0;strokeColor=#FB8C00;" vertex="1" parent="1">
          <mxGeometry x="90" y="1275" width="140" height="28" as="geometry" />
        </mxCell>
        <mxCell id="LG-2" value="App 層" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E3F2FD;strokeColor=#1E88E5;" vertex="1" parent="1">
          <mxGeometry x="240" y="1275" width="140" height="28" as="geometry" />
        </mxCell>
        <mxCell id="LG-3" value="Agent 実行層" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E8EAF6;strokeColor=#3949AB;" vertex="1" parent="1">
          <mxGeometry x="390" y="1275" width="140" height="28" as="geometry" />
        </mxCell>
        <mxCell id="LG-4" value="ガバナンス制御" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FCE4EC;strokeColor=#C2185B;" vertex="1" parent="1">
          <mxGeometry x="540" y="1275" width="140" height="28" as="geometry" />
        </mxCell>
        <mxCell id="LG-5" value="Data 層" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F3E5F5;strokeColor=#8E24AA;" vertex="1" parent="1">
          <mxGeometry x="690" y="1275" width="140" height="28" as="geometry" />
        </mxCell>
        <mxCell id="LG-6" value="オブザーバビリティ" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E0F7FA;strokeColor=#00838F;" vertex="1" parent="1">
          <mxGeometry x="840" y="1275" width="140" height="28" as="geometry" />
        </mxCell>
        <mxCell id="LG-7" value="External" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E8F5E9;strokeColor=#43A047;" vertex="1" parent="1">
          <mxGeometry x="990" y="1275" width="140" height="28" as="geometry" />
        </mxCell>
        <mxCell id="LG-8" value="拡張予定（MVP 外）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F5F5F5;strokeColor=#9E9E9E;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1275" width="140" height="28" as="geometry" />
        </mxCell>
        <mxCell id="LG-9" value="CI/CD" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF8E1;strokeColor=#FFB300;" vertex="1" parent="1">
          <mxGeometry x="1290" y="1275" width="140" height="28" as="geometry" />
        </mxCell>
        <mxCell id="LG-10" value="‑ ‑ ‑ 配信（External→Client）専用の破線" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;dashed=1;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#558B2F;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1275" width="210" height="28" as="geometry" />
        </mxCell>
        <mxCell id="LG-11" value="点線枠 = 境界 / [G*] ガバナンス制御・[O*] 観測点" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;dashed=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;" vertex="1" parent="1">
          <mxGeometry x="1660" y="1275" width="300" height="28" as="geometry" />
        </mxCell>
        <mxCell id="CONTROLS" value="&lt;b&gt;制御ポイント一覧（図中の [G*] / [O*] と対応。docs/ARCHITECTURE.md §3.4.3）&lt;/b&gt;&lt;br&gt;[G1] Ingress：管理人の指示・住民の自由文を Agent へ渡す入口を1本化。認証済みの API からのみ受け付ける。&lt;br&gt;[G2] Model Armor：入力はインジェクション / Jailbreak を遮断。応答・ツールのペイロードは SDP フィルタで部屋番号・氏名を検出して遮断（Privacy Gateway の検出層。抽象トークン化は Resident Agent 側のコード）。&lt;br&gt;[G3] Egress：Agent の外向き通信（A2A・MCP・Gemini）をすべて通す＝Outbound Privacy Gate（原則6／REQ-06）。&lt;br&gt;[G4] IAP エージェントポリシー：Resident Agent を呼べるのは Building Agent だけ。Resident Agent は自分の住民のデータの読み取りと評価結果の記録だけ。承認の書き込み・部屋番号の開示はどの Agent も不可。&lt;br&gt;[G5] Policy Engine：未承認の実行・開示・児童保護違反を Firestore の承認状態で決定論的に判定（原則4・5）。本線はツールサービス内のコード、ext_authz での二重化は余力（EXT-07）。&lt;br&gt;[G6] Agent Registry：呼べる Agent / MCP Server / Endpoint（Gemini API を含む）の台帳。未登録の宛先は拒否。&lt;br&gt;[G7] 監査ログ：Gateway の許可・拒否、承認、開示を保持ロック付きバケットへ（運用者向け）。住民向けの説明は Firestore の AuditEvent。&lt;br&gt;[G8] 評価（余力・EXT-07）：「未承認の Commit がない」「最大公開ラインを超えない」を評価指標に入れ、CI でデプロイ前に判定。&lt;br&gt;[O1] Trace：ADK 組込の OTel。スパンの内容は NO_CONTENT（プロンプト本文を残さない）。&lt;br&gt;[O3] BigQuery（図のみ・EXT-08）：構造化イベントのみ。prompt-response logging は無効化する。&lt;br&gt;[O4] Monitoring（余力・EXT-07）：遅延・エラー率 SLO、モデル / Tool のエラー率、トークン急増、Model Armor の検知率、IAM 拒否率。&lt;br&gt;[O5] Online Monitors（図のみ・EXT-08）：Building Agent の計画品質・Tool 使用品質・ハルシネーションを本番トラフィックで評価。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;spacingLeft=8;spacingTop=6;strokeColor=#D0D0D0;fillColor=#FAFAFA;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1320" width="1000" height="330" as="geometry" />
        </mxCell>
        <mxCell id="NOTE" value="&lt;b&gt;Scope（対象）&lt;/b&gt;：MVP の実行時構成のうち、AI Agent のガバナンス（Agent Gateway・Model Armor・IAP ポリシー・Policy Engine・Registry）とオブザーバビリティ（Trace・Logging・Monitoring・評価）/ L2。データ・制御の流れ全体はランタイム構成図 v1.2。&lt;br&gt;&lt;b&gt;対象外&lt;/b&gt;：Pub/Sub・Secret Manager・Artifact Registry、平時のデータ収集、VPC / サブネット、停電時のフォールバック（docs/ARCHITECTURE.md §1・§4）。テレメトリの矢印は省略（全コンポーネントが OTel・ログを送る）。&lt;br&gt;&lt;b&gt;入力ソース&lt;/b&gt;：docs/ARCHITECTURE.md §3.4・§3.5、docs/DESIGN.md §5、docs/SPEC.md §4〜6、docs/PLAN.md §2、docs/review/murakami_review（A-4）&lt;br&gt;&lt;b&gt;Assumptions&lt;/b&gt;：Gateway は Standalone モード（ACT・PSC-I なし）。Building Agent・Resident Agent は Agent Runtime（同じ Gateway に紐づく）、ツールは Cloud Run。リージョンは us-central1。Resident Agent は Firestore に直接触れず、ツール経由で自分の住民のデータだけを読む。部屋番号は承認後にのみ開示。承認は住民本人の操作（API）だけが書き込み、Agent は書き込めない。&lt;br&gt;&lt;b&gt;区分&lt;/b&gt;：無印＝MVP で実装／（余力）＝FN-10・FN-11 の後に余力があれば（EXT-07）／（図のみ）＝グレー、提出資料に書くだけ（EXT-08）。&lt;br&gt;&lt;b&gt;未確定（TBD）&lt;/b&gt;：① Gemini API を Standalone の Egress 経由にする設定（実装時に確認。不可なら直接呼び出し＋floor 設定で補い見直す）　② VPC-SC・CMEK（EXT-05）　③ Semantic Governance Policies は LLM 判定のため補助扱い（強制は G4・G5）　④ アラートの通知先　⑤ Model Armor / SDP の日本語検出精度　⑥ Online Monitors・Trace・Logging の追加課金　⑦ FCM の高リスク用途規約（既存 TBD と連動）&lt;br&gt;v1.1：Resident Agent を Agent Runtime へ移し Firestore・Gemini への直結を廃止、リージョン us-central1、Firestore 表記を ER 図準拠、MVP 区分を追記（v1.0 は村上作成）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;spacingLeft=8;spacingTop=6;strokeColor=#D0D0D0;fillColor=#FAFAFA;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1060" y="1320" width="900" height="330" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>