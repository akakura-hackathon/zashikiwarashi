        <mxCell id="C-012" value="&lt;b&gt;[G3] Agent Gateway：Egress&lt;/b&gt;&lt;br&gt;AGENT_TO_ANYWHERE&lt;br&gt;Agent の外向き通信を&lt;br&gt;全件経由（A2A / MCP / Gemini）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#FCE4EC;strokeColor=#C2185B;" vertex="1" parent="1">
