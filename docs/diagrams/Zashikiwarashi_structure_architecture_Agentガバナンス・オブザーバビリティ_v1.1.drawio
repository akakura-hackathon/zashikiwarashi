        <mxCell id="C-040" value="&lt;b&gt;[O1] Cloud Trace&lt;/b&gt;&lt;br&gt;OTel スパン（内容は記録しない）&lt;br&gt;plan_id で Agent 横断を追跡" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E0F7FA;strokeColor=#00838F;" vertex="1" parent="1">
