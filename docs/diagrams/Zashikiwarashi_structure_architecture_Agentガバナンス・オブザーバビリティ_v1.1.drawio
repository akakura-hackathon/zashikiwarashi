        <mxCell id="C-023" value="Gemini on Agent Platform&lt;br&gt;3.1 Pro：協力計画の生成&lt;br&gt;3.8 Flash：抽象化" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E8EAF6;strokeColor=#3949AB;" vertex="1" parent="1">
