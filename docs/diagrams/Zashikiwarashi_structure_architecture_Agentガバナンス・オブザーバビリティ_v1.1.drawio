        </mxCell>
        <mxCell id="C-050" value="Firebase Cloud Messaging&lt;br&gt;HTTP v1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E8F5E9;strokeColor=#43A047;" vertex="1" parent="1">
