          <mxGeometry as="geometry" x="358" y="347.0" width="26" height="26" />
        </mxCell>

        <!-- Data層: Firestore & Secret Manager -->
        <mxCell id="C-010" value="&lt;b&gt;Cloud Firestore（Native Mode）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;・建物50戸フロア・部屋グラフ&lt;br&gt;・住民・世帯・在館コンテキスト&lt;br&gt;・Issue / Task / TaskEvent (監査履歴) (C-010)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#F3E5F5;strokeColor=#8E24AA;spacingLeft=30;" vertex="1" parent="1">
