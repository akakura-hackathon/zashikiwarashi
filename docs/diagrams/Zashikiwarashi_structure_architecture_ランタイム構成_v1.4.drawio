        </mxCell>
        <mxCell id="C-013" value="&lt;b&gt;Secret Manager&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;APIキー・秘密情報暗号化管理 (C-013)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#F3E5F5;strokeColor=#8E24AA;spacingLeft=30;" vertex="1" parent="1">
