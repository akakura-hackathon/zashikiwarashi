            ============================================================== -->
        <mxCell id="C-040" value="&lt;b&gt;[G1] Agent Gateway（Ingress）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;CLIENT_TO_AGENT (C-040)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#FFF8E1;strokeColor=#FFB300;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="665" y="285" width="190" height="48" />
        </mxCell>
        <mxCell id="C-023" value="&lt;b&gt;[G2] Model Armor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;入力: 悪意プロンプト物理遮断 (HTTP 400)&lt;br&gt;出力: SDP 部屋番号/氏名漏洩遮断 (C-023)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=9;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#FFF8E1;strokeColor=#FFB300;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="665" y="365" width="190" height="58" />
        </mxCell>
        <mxCell id="C-041" value="&lt;b&gt;[G3] Agent Gateway（Egress）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;AGENT_TO_ANYWHERE&lt;br&gt;A2A・MCP・Gemini API の全件統制&lt;br&gt;&lt;b&gt;[G4] IAP ポリシー（Agent Identity × CEL）&lt;/b&gt;&lt;br&gt;権限外ツール呼び出し物理遮断 (C-041)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=9;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#FFF8E1;strokeColor=#FFB300;" vertex="1" parent="1">
