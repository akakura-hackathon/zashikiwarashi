        <mxCell id="C-004" value="&lt;b&gt;Resident Agent (住民代理人)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;resident_id ごとに完全セッション分離&lt;br&gt;逆提案・開示最小化・聞き返し対話生成 (C-004)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E3F2FD;strokeColor=#1E88E5;" vertex="1" parent="1">
