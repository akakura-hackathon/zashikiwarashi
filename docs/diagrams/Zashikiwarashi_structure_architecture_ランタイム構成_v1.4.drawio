        <!-- ==============================================================
            App層: API Ingestion & 再トリアージ自律選定
            ============================================================== -->
        <mxCell id="C-001" value="&lt;b&gt;API Ingestion &amp;amp; Triage Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;FastAPI / Cloud Run（非公開）&lt;br&gt;・4大災害トリアージ（地震/停電/火災/洪水）&lt;br&gt;・再トリアージ（Re-triage）代替候補自動選定&lt;br&gt;・承認/開示は Policy Engine を強制 (C-001)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E3F2FD;strokeColor=#1E88E5;spacingLeft=30;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="350" y="260" width="230" height="200" />
