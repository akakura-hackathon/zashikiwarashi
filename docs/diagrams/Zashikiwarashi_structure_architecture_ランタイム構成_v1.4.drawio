        <!-- ==============================================================
            Multi-Agent 実行層 (Agent Runtime)
            ============================================================== -->
        <mxCell id="C-003" value="&lt;b&gt;Building Agent (Coordinator)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;Google ADK / Reasoning Engines&lt;br&gt;建物全体最適化・空間タスク分割&lt;br&gt;4大災害トリアージ・再計画自律立案 (C-003)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E3F2FD;strokeColor=#1E88E5;" vertex="1" parent="1">
