        <mxCell id="C-100" value="&lt;b&gt;モバイル実機フレーム&lt;br&gt;（PhoneStage PWA）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;住民画面（安否確認・被害入力・タスク受諾）&lt;br&gt;管理人画面（50戸状況・フロアマップ・TaskBoard） (C-100)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#FFF3E0;strokeColor=#FB8C00;" vertex="1" parent="1">
