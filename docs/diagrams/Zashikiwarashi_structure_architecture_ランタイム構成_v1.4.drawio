        <mxCell id="C-043" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;Firebase ID トークンを物理検証&lt;br&gt;未認証リクエストを遮断 (C-043)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#FFF8E1;strokeColor=#FFB300;" vertex="1" parent="1">
