        <mxCell id="C-042" value="&lt;b&gt;[G6] Agent Registry&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;未登録宛先・未承認ツールの拒否 (C-042)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=9;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#FFF8E1;strokeColor=#FFB300;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="665" y="635" width="190" height="50" />
