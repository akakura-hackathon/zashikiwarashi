        <mxCell id="C-002" value="&lt;b&gt;Firebase Authentication&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;JWT・Google OAuth・セッション管理 (C-002)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E3F2FD;strokeColor=#1E88E5;" vertex="1" parent="1">
