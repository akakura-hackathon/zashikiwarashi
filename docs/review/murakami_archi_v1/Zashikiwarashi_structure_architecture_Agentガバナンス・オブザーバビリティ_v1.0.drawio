        <mxCell id="C-013" value="&lt;b&gt;[G4] IAP エージェントポリシー&lt;/b&gt;&lt;br&gt;Agent Identity × CEL 条件&lt;br&gt;誰がどの Agent / Tool を呼べるか" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#FCE4EC;strokeColor=#C2185B;" vertex="1" parent="1"><mxGeometry x="880" y="685" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="C-014" value="&lt;b&gt;[G5] Policy Engine&lt;/b&gt;&lt;br&gt;Cloud Run・ext_authz 拡張&lt;br&gt;未承認 Commit・開示・児童保護を遮断" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#FCE4EC;strokeColor=#C2185B;" vertex="1" parent="1"><mxGeometry x="620" y="685" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="C-016" value="&lt;b&gt;[G6] Agent Registry&lt;/b&gt;&lt;br&gt;Agent・MCP Server・Endpoint 台帳&lt;br&gt;未登録の宛先は拒否（default deny）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#FCE4EC;strokeColor=#C2185B;" vertex="1" parent="1"><mxGeometry x="880" y="795" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="C-020" value="&lt;b&gt;Building Agent&lt;/b&gt;&lt;br&gt;Agent Runtime（ADK）&lt;br&gt;Agent Identity・Sessions" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E8EAF6;strokeColor=#3949AB;" vertex="1" parent="1"><mxGeometry x="1160" y="305" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="C-021" value="&lt;b&gt;Resident Agent&lt;/b&gt;&lt;br&gt;Cloud Run（ADK / A2A）&lt;br&gt;resident_id ごとに Context 分離" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E8EAF6;strokeColor=#3949AB;" vertex="1" parent="1"><mxGeometry x="1440" y="517" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="C-023" value="Gemini on Agent Platform&lt;br&gt;3.1 Pro：協力計画の生成&lt;br&gt;3.8 Flash：抽象化" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E8EAF6;strokeColor=#3949AB;" vertex="1" parent="1"><mxGeometry x="1440" y="625" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="C-022" value="Zashikiwarashi Tools&lt;br&gt;MCP Server（Cloud Run）&lt;br&gt;空間グラフ / Plan / 通知" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E8EAF6;strokeColor=#3949AB;" vertex="1" parent="1"><mxGeometry x="1440" y="725" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="C-030" value="Cloud Firestore&lt;br&gt;buildings / residents /&lt;br&gt;active_plans（approvals・audit_trail）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#F3E5F5;strokeColor=#8E24AA;" vertex="1" parent="1"><mxGeometry x="1440" y="895" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="C-050" value="Firebase Cloud Messaging&lt;br&gt;HTTP v1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E8F5E9;strokeColor=#43A047;" vertex="1" parent="1"><mxGeometry x="1740" y="725" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="C-051" value="外部データ連携（拡張 E1〜E4）&lt;br&gt;Calendar / スマートメーター /&lt;br&gt;インターホン　※MVP はダミー" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#F5F5F5;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="1740" y="825" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="C-040" value="&lt;b&gt;[O1] Cloud Trace&lt;/b&gt;&lt;br&gt;OTel スパン（内容は記録しない）&lt;br&gt;plan_id で Agent 横断を追跡" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E0F7FA;strokeColor=#00838F;" vertex="1" parent="1"><mxGeometry x="350" y="1040" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="C-041" value="&lt;b&gt;[O2] Cloud Logging&lt;/b&gt;&lt;br&gt;Gateway・IAP 判定・Model Armor&lt;br&gt;・Agent Runtime のログ" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E0F7FA;strokeColor=#00838F;" vertex="1" parent="1"><mxGeometry x="610" y="1040" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="C-043" value="&lt;b&gt;[O3] BigQuery&lt;/b&gt;&lt;br&gt;Agent Analytics（イベントのみ）&lt;br&gt;協議ラウンド・Tool 使用・結果" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E0F7FA;strokeColor=#00838F;" vertex="1" parent="1"><mxGeometry x="870" y="1040" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="C-044" value="&lt;b&gt;[O4] Cloud Monitoring&lt;/b&gt;&lt;br&gt;SLO・アラート・ダッシュボード&lt;br&gt;信頼性 / コスト / 安全 / セキュリティ" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E0F7FA;strokeColor=#00838F;" vertex="1" parent="1"><mxGeometry x="1130" y="1040" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="C-042" value="&lt;b&gt;[G7] 監査ログバケット&lt;/b&gt;&lt;br&gt;保持ロック（改ざん防止）&lt;br&gt;Gateway 判定・承認・開示の記録" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E0F7FA;strokeColor=#00838F;" vertex="1" parent="1"><mxGeometry x="610" y="1140" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="C-045" value="&lt;b&gt;[O5] Online Monitors&lt;/b&gt;&lt;br&gt;Agent Platform のオンライン評価&lt;br&gt;計画品質・ハルシネーション" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E0F7FA;strokeColor=#00838F;" vertex="1" parent="1"><mxGeometry x="1130" y="1140" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="C-046" value="&lt;b&gt;[G8] Gen AI Evaluation&lt;/b&gt;&lt;br&gt;4 シナリオの評価データセット&lt;br&gt;デプロイ前の品質・安全ゲート" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#E0F7FA;strokeColor=#00838F;" vertex="1" parent="1"><mxGeometry x="1390" y="1140" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="C-060" value="GitHub Actions（WIF）&lt;br&gt;Terraform / agents-cli deploy&lt;br&gt;評価ゲート通過後に反映" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;align=center;verticalAlign=middle;fillColor=#FFF8E1;strokeColor=#FFB300;" vertex="1" parent="1"><mxGeometry x="1740" y="1140" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="KEY" value="&lt;b&gt;提案の要点&lt;/b&gt;&lt;br&gt;&lt;br&gt;① Agent の入出力はすべて &lt;b&gt;Agent Gateway&lt;/b&gt; を経由させる（Ingress / Egress）&lt;br&gt;&lt;br&gt;② &lt;b&gt;Model Armor&lt;/b&gt; で入力（プロンプトインジェクション）と応答（部屋番号・氏名）を検査する&lt;br&gt;&lt;br&gt;③ 権限はコードで強制する：&lt;b&gt;IAP エージェントポリシー&lt;/b&gt;（誰が何を呼べるか）＋ &lt;b&gt;Policy Engine&lt;/b&gt;（承認前の Commit・開示を遮断）&lt;br&gt;&lt;br&gt;④ &lt;b&gt;Agent Identity / Agent Registry&lt;/b&gt; で呼び出し元と宛先を台帳管理する&lt;br&gt;&lt;br&gt;⑤ OTel トレースを plan_id で Agent 横断に追う。プロンプト本文はログに残さない&lt;br&gt;&lt;br&gt;⑥ 評価（デプロイ前＋Online Monitors）とアラートで、品質と安全を継続的に監視する" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;spacingLeft=8;spacingTop=6;strokeColor=#D0D0D0;fillColor=#FAFAFA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="250" height="560" as="geometry"/></mxCell>
        <mxCell id="TELEMETRY" value="テレメトリの送信元：Agent Gateway / Agent Runtime / Cloud Run の全サービス（OTel SDK・ADK 組込、Gateway ログ）。矢印は省略。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#006064;" vertex="1" parent="1"><mxGeometry x="1390" y="1040" width="270" height="64" as="geometry"/></mxCell>
        <mxCell id="LG-title" value="凡例" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#1A2538;" vertex="1" parent="1"><mxGeometry x="40" y="1275" width="40" height="28" as="geometry"/></mxCell>
        <mxCell id="LG-1" value="Client 層" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF3E0;strokeColor=#FB8C00;" vertex="1" parent="1"><mxGeometry x="90" y="1275" width="140" height="28" as="geometry"/></mxCell>
        <mxCell id="LG-2" value="App 層" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E3F2FD;strokeColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="240" y="1275" width="140" height="28" as="geometry"/></mxCell>
        <mxCell id="LG-3" value="Agent 実行層" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E8EAF6;strokeColor=#3949AB;" vertex="1" parent="1"><mxGeometry x="390" y="1275" width="140" height="28" as="geometry"/></mxCell>
        <mxCell id="LG-4" value="ガバナンス制御" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FCE4EC;strokeColor=#C2185B;" vertex="1" parent="1"><mxGeometry x="540" y="1275" width="140" height="28" as="geometry"/></mxCell>
        <mxCell id="LG-5" value="Data 層" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F3E5F5;strokeColor=#8E24AA;" vertex="1" parent="1"><mxGeometry x="690" y="1275" width="140" height="28" as="geometry"/></mxCell>
        <mxCell id="LG-6" value="オブザーバビリティ" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E0F7FA;strokeColor=#00838F;" vertex="1" parent="1"><mxGeometry x="840" y="1275" width="140" height="28" as="geometry"/></mxCell>
        <mxCell id="LG-7" value="External" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E8F5E9;strokeColor=#43A047;" vertex="1" parent="1"><mxGeometry x="990" y="1275" width="140" height="28" as="geometry"/></mxCell>
        <mxCell id="LG-8" value="拡張予定（MVP 外）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F5F5F5;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="1140" y="1275" width="140" height="28" as="geometry"/></mxCell>
        <mxCell id="LG-9" value="CI/CD" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF8E1;strokeColor=#FFB300;" vertex="1" parent="1"><mxGeometry x="1290" y="1275" width="140" height="28" as="geometry"/></mxCell>
        <mxCell id="LG-10" value="‑ ‑ ‑ 配信（External→Client）専用の破線" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;dashed=1;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#558B2F;" vertex="1" parent="1"><mxGeometry x="1440" y="1275" width="210" height="28" as="geometry"/></mxCell>
        <mxCell id="LG-11" value="点線枠 = 境界 / [G*] ガバナンス制御・[O*] 観測点" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;dashed=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="1660" y="1275" width="300" height="28" as="geometry"/></mxCell>
        <mxCell id="CONTROLS" value="&lt;b&gt;制御ポイント一覧（図中の [G*] / [O*] と対応）&lt;/b&gt;&lt;br&gt;&lt;b&gt;[G1] Ingress&lt;/b&gt;：管理人の指示・住民の Need を Agent へ渡す入口を1本化。認証済みの API からのみ受け付ける。&lt;br&gt;&lt;b&gt;[G2] Model Armor&lt;/b&gt;：入力はインジェクション / Jailbreak を遮断。応答は SDP フィルタで部屋番号・氏名を検出（Privacy Gateway の検出層。抽象トークン化は Resident Agent 側のコード）。&lt;br&gt;&lt;b&gt;[G3] Egress&lt;/b&gt;：Agent の外向き通信（A2A・MCP・Gemini）をすべて通す＝Outbound Privacy Gate（原則6／受け入れ基準「外向きメッセージが Gateway を通る」）。&lt;br&gt;&lt;b&gt;[G4] IAP エージェントポリシー&lt;/b&gt;：Resident Agent を呼べるのは Building Agent だけ。Tool ごとに read-only かを CEL で制限（原則6 Agent Isolation）。&lt;br&gt;&lt;b&gt;[G5] Policy Engine&lt;/b&gt;：commit_plan / disclose_location の呼び出しを、Firestore の承認状態で決定論的に判定。LLM の判断に依存しない（原則4・5）。&lt;br&gt;&lt;b&gt;[G6] Agent Registry&lt;/b&gt;：呼べる Agent / MCP Server / Endpoint の台帳。未登録の宛先は拒否。&lt;br&gt;&lt;b&gt;[G7] 監査ログ&lt;/b&gt;：Gateway の許可・拒否、承認、開示を保持ロック付きバケットへ（運用者向け）。住民向けの説明は Firestore audit_trail。&lt;br&gt;&lt;b&gt;[G8] 評価&lt;/b&gt;：「未承認の Commit がない」「最大公開ラインを超えない」を評価指標に入れ、CI でデプロイ前に判定。&lt;br&gt;&lt;b&gt;[O1] Trace&lt;/b&gt;：ADK 組込の OTel。スパンの内容は NO_CONTENT（プロンプト本文を残さない）。&lt;br&gt;&lt;b&gt;[O3] BigQuery&lt;/b&gt;：構造化イベントのみ。プロンプト全文を GCS / BigQuery に書く prompt-response logging は無効化する。&lt;br&gt;&lt;b&gt;[O4] Monitoring&lt;/b&gt;：遅延・エラー率 SLO、モデル / Tool のエラー率、トークン急増、Model Armor の検知率、IAM 拒否率。&lt;br&gt;&lt;b&gt;[O5] Online Monitors&lt;/b&gt;：Building Agent の計画品質・Tool 使用品質・ハルシネーションを本番トラフィックで評価。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;spacingLeft=8;spacingTop=6;strokeColor=#D0D0D0;fillColor=#FAFAFA;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="1000" height="330" as="geometry"/></mxCell>
        <mxCell id="NOTE" value="&lt;b&gt;Scope（対象）&lt;/b&gt;：MVP の実行時構成のうち、AI Agent のガバナンス（Agent Gateway・Model Armor・IAP ポリシー・Policy Engine・Registry）とオブザーバビリティ（Trace・Logging・Monitoring・評価）/ L2。&lt;br&gt;&lt;b&gt;対象外&lt;/b&gt;：Pub/Sub・Secret Manager・Artifact Registry、平時のデータ収集、VPC / サブネット、停電時のフォールバック（docs/ARCHITECTURE.md §1・§4）。テレメトリの矢印は省略（全コンポーネントが OTel・ログを送る）。&lt;br&gt;&lt;b&gt;入力ソース&lt;/b&gt;：docs/SPEC.md §4〜6、docs/DESIGN.md §1・§5・§7、docs/ARCHITECTURE.md §3、docs/PLAN.md §2、docs/review/murakami_review（A-4）&lt;br&gt;&lt;b&gt;Assumptions&lt;/b&gt;：Gateway は Standalone モード（ACT・PSC-I なし）で開始。部屋番号は承認後にのみ開示。承認は住民本人の操作（API）だけが書き込み、Agent は書き込めない。&lt;br&gt;&lt;b&gt;未確定（TBD）&lt;/b&gt;：① Resident Agent を Agent Runtime に載せて Gateway 配下にするか（1つの Gateway に紐づく Reasoning Engine は1つ）　② リージョン（Gateway と Agent Runtime は同一リージョン必須。asia-northeast1 の可否）　③ VPC-SC・CMEK（SPEC §4.4 / E6 で拡張扱い）　④ Semantic Governance Policies は LLM 判定のため補助扱い（強制は G4・G5）　⑤ アラートの通知先　⑥ Model Armor / SDP の日本語検出精度　⑦ Online Monitors・Trace・Logging の追加課金　⑧ FCM の高リスク用途規約（既存 TBD と連動）&lt;br&gt;v1.0（初版）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;spacingLeft=8;spacingTop=6;strokeColor=#D0D0D0;fillColor=#FAFAFA;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1060" y="1320" width="900" height="330" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
