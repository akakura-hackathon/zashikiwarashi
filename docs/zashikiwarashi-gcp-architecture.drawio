        </mxCell>
        <mxCell id="vx" value="&lt;b&gt;Vertex AI&lt;/b&gt;&lt;br&gt;&lt;div style='text-align:left;font-size:11px'&gt;&lt;br&gt;&lt;b&gt;Gemini 3.8 Flash&lt;/b&gt;&lt;br&gt;Agent間メッセージの抽象化・意図解釈&lt;br&gt;&lt;br&gt;&lt;b&gt;Gemini 3.1 Pro&lt;/b&gt;&lt;br&gt;空間グラフ+制約から協力計画を構造化生成&lt;br&gt;（JSON Schema 準拠）&lt;br&gt;&lt;br&gt;&lt;i&gt;※モデル名・提供状況は docs 記載のまま。実装時に要確認&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9334E6;strokeWidth=1.5;align=center;verticalAlign=top;spacing=6;fontSize=12;fontFamily=Helvetica;spacingLeft=40;" parent="1" vertex="1">
